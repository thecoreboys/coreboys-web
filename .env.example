# Twitch Helix — used by app/api/twitch/live for live status.
# Create an app at https://dev.twitch.tv/console/apps and use the
# client-credentials grant.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NEXT_PUBLIC_TWITCH_TIER_ONE_PRICE_LABEL="US $5.99"

# Canonical public origin used for absolute URLs in metadata, OG, and sitemap.
NEXT_PUBLIC_SITE_URL=https://thecoreboys.com
# Local development may override it without changing the production value:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DJ Cora's approved ElevenLabs voice is used only by the offline cue-production
# workflow. Browser playback always uses approved, uploaded recordings.
ELEVENLABS_DJ_CORA_VOICE_ID=st7NwhTPEzqo2riw7qWC

# Secret header used by a scheduler to invoke the idempotent FanZone cleanup.
FANZONE_CRON_SECRET=
# Optional separate origin used by scripts/run-fanzone-retention.mjs.
FANZONE_RETENTION_URL=

# Staff admin + member-manager sessions (HS256). Use a random value of at
# least 24 characters. Staff roles and member assignments remain authoritative
# in Postgres and are re-read on every protected request.
ADMIN_SESSION_SECRET=
# Separate base64-encoded 32-byte key used only to encrypt admin TOTP seeds at rest.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_TOTP_ENCRYPTION_KEY=
# One-shot inputs for `pnpm db:seed-admin`. Keep these unset in deployed app
# processes when the seed is not running; never commit real values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Social Fetch (https://socialfetch.dev) — populates follower/subscriber counts
# and the scheduled public TikTok + Instagram media snapshot without creator
# logins. Paid media reads are cron-only and globally rate-gated in Postgres.
# Snapchat is not covered and uses explicit manualCounts where configured.
SOCIAL_FETCH_API_KEY=

# Postgres stores durable follower/subscriber snapshots. Profile pages read
# these first and use cached API-only lookups when a snapshot is missing.
DATABASE_URL=
# Dedicated local-only media search database. The application intentionally
# never falls back to DATABASE_URL for AI indexing. pgvector and pg_trgm are
# used automatically when already installed; Redis is not required.
MEDIA_INTELLIGENCE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56222/coreboys_media_ai
MEDIA_INTELLIGENCE_ALLOW_REMOTE_DATABASE=false
MEDIA_INTELLIGENCE_PROVIDER=local
# Scheduler/admin pipeline. Visitor search is read-only and never queues work.
MEDIA_INTELLIGENCE_CRON_SECRET=
MEDIA_INTELLIGENCE_APP_URL=
MEDIA_INTELLIGENCE_SYNC_MAX_JOBS=100
MEDIA_INTELLIGENCE_ARCHIVE_MAX_PAGES=8
MEDIA_INTELLIGENCE_ARCHIVE_PAGE_SIZE=50
MEDIA_INTELLIGENCE_RETENTION_LIMIT=250
MEDIA_INTELLIGENCE_JOB_LEASE_SECONDS=300
# JSON keyed by platform or normalized source key. Deep mode is still denied
# unless rights are owned/licensed and binary media access is explicitly true.
MEDIA_INTELLIGENCE_SOURCE_POLICIES_JSON={}
# Optional Azure adapters. Leave blank with provider=local for metadata-only CI.
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_API_KEY=
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=
AZURE_VIDEO_INDEXER_ACCOUNT_ID=
AZURE_VIDEO_INDEXER_LOCATION=
AZURE_VIDEO_INDEXER_SUBSCRIPTION_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_MEDIA_CONTAINER=media-intelligence
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_MEDIA_QUEUE=media-intelligence
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX=core-media
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# Consent-first face-presence pilot. Both switches stay off by default. The
# analyzer runs locally against authorized sources; the web process never
# downloads or scans Twitch/YouTube iframe pixels.
FACE_ANALYZER_ENABLED=false
FACE_AUTOMATIC_MATCHING_ENABLED=false
FACE_PRESENCE_PUBLIC_ENABLED=false
# Separate compile-time player UI gate. Public tags require both this and the
# server-side FACE_PRESENCE_PUBLIC_ENABLED flag.
NEXT_PUBLIC_FACE_PRESENCE_UI_ENABLED=false
FACE_REFERENCE_UPLOADS_ENABLED=false
# A protected directory outside /public for short-lived enrollment and review
# evidence. Do not point this at a synced or web-served folder.
FACE_REFERENCE_STORAGE_DIR=
# Required authority connection for biometric worker operations. Use a
# restricted loopback-only role; the worker never falls back to DATABASE_URL.
FACE_ANALYZER_DATABASE_URL=
# Dedicated high-entropy secret for the idempotent retention route. Never
# reuse an admin, analyzer, webhook, or other cron credential.
FACE_RETENTION_CRON_SECRET=
FACE_RETENTION_URL=
# Shared secret sent as x-cron-secret when invoking the daily metrics writer.
METRICS_CRON_SECRET=

# Fan sessions (HS256). Also used to derive the OAuth token vault key
# unless FAN_OAUTH_KEY is set.
FAN_SESSION_SECRET=
# Optional dedicated 32+ char key for encrypting connected-account tokens.
FAN_OAUTH_KEY=

# YouTube (Google) OAuth — fan connect. Production redirect:
#   https://thecoreboys.com/api/oauth/youtube/callback
# OAuth requests youtube.readonly plus youtube.force-ssl. The latter enables
# explicit viewer-submitted comments/live-chat and requires Google verification
# before general production use; it does not enable automatic posting here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side Data API key for handle resolution, duration/live metadata,
# and Shorts heuristics. RSS-by-channel-id still works without it.
YOUTUBE_API_KEY=
# Optional no-quota overrides for a renamed or newly added channel. Keys may
# be handles or full channel URLs; values are public UC channel ids.
# Example: {"@example":"UCxxxxxxxxxxxxxxxxxxxxxx"}
YOUTUBE_CHANNEL_IDS_JSON=

# Patreon teasers are read only from the signed-out public campaign page.
# Creator tokens are intentionally not accepted by the public Watch shelf.

# X OAuth 2.0 — fan connect. Redirects:
#   https://thecoreboys.com/api/oauth/x/callback
#   http://localhost:3003/api/oauth/x/callback
# The public feed uses the app Bearer Token; OAuth client keys remain for
# fan-account connections. X API usage is credit/pay-per-use as configured
# in the X Developer Console.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
  # Minimum minutes between the single scheduled roster refreshes (5..1440).
  X_FEED_REFRESH_MINUTES=5
  # Set once after enabling X full-archive search to load the prior five
  # months. It records completion and will not run again until that marker is
  # cleared. This API access is paid; leave false for recent-search only.
  X_FEED_FULL_ARCHIVE_BACKFILL=false
  X_FEED_FULL_ARCHIVE_MAX_PAGES=10
X_FEED_ALLOW_LOCAL_REFRESH=false
# Exact X Community ids/URLs only. Unknown or invalid rows are ignored and the
# UI shows an honest "not configured" state. Never substitute profile URLs.
# Example: {"core":{"id":"1234567890123456789","description":"Official CORE Community","featuredPostIds":["https://x.com/name/status/1234567890123456789"]}}
X_COMMUNITIES_JSON={}
# JSON array or comma-separated direct post URLs/ids. Empty means no editorial
# featured post; ordinary roster posts can still appear from the cron snapshot.
X_FEATURED_POST_IDS=[]

# Native fan-account writes are fail-closed. All four controls must be set by
# an operator from the current X Developer Console before one-tap actions work:
# explicit enable, declared remaining credits, monthly cap, and unit estimate.
# Official X Web Intents remain available while this is false.
X_NATIVE_ACTIONS_ENABLED=false
X_API_CREDIT_BALANCE_USD=0
X_API_MONTHLY_CEILING_USD=0
X_API_WRITE_ACTION_UNIT_USD=0
# Read estimates power the hard preflight ceiling. Set them to current X
# dashboard prices; zero means "unknown price" and blocks paid read refreshes.
X_API_READ_POST_UNIT_USD=0
X_API_READ_USER_UNIT_USD=0
# X does not currently document an API for publishing into a Community. The
# application endpoint is deliberately hard-disabled regardless of env config.
X_COMMUNITY_POSTS_ENABLED=false

# TikTok Login Kit — fan connect. Production redirect:
#   https://thecoreboys.com/api/oauth/tiktok/callback
# TikTok Web redirect URIs must be static, absolute HTTPS URLs. Test from a
# deployed HTTPS sandbox/preview; http://localhost cannot be registered.
# App website / compliance URLs:
#   Website: https://thecoreboys.com/
#   Privacy: https://thecoreboys.com/legal/privacy
#   Terms: https://thecoreboys.com/legal/terms
# App review must approve user.info.basic,user.info.profile,video.list.
# The app also needs both Login Kit and TikTok API / Display API products.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Server-only creator account map, keyed by bare handle. This is the only
# credential source for public creator media; viewer OAuth accounts are never
# used. Include TikTok open_id when enabling signed webhook fast-paths.
# Example: {"officialcoreboys":{"accessToken":"...","openId":"..."}}
TIKTOK_ACCOUNT_TOKENS_JSON=
# Optional legacy single-account fallback; both values are required so one
# token can never be mislabeled as a different member.
TIKTOK_ACCOUNT_HANDLE=
TIKTOK_ACCESS_TOKEN=

# Instagram Login — fan connect. Production redirect:
#   https://thecoreboys.com/api/oauth/instagram/callback
# Current fan sync is read-only (instagram_business_basic). Professional-account
# comment replies require Meta review for instagram_business_manage_comments and
# are intentionally not requested until that review is approved.
# Meta App Dashboard compliance URLs:
#   Privacy Policy: https://thecoreboys.com/legal/privacy
#   Terms: https://thecoreboys.com/legal/terms
#   Data deletion instructions: https://thecoreboys.com/legal/data-deletion
#   Data deletion callback: https://thecoreboys.com/api/meta/data-deletion
# The callback verifies Meta's signed_request with INSTAGRAM_CLIENT_SECRET;
# FACEBOOK_APP_SECRET is also accepted when using a Facebook-mode app.
# These Instagram Login credentials must be a matched pair. FACEBOOK_APP_ID /
# FACEBOOK_APP_SECRET are for Facebook Graph-mode creator tokens and are never
# substituted into the Instagram Login authorization-code flow.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Server-only creator professional-account map. Viewer OAuth accounts are never
# used. Values can be a token string or
# {"accessToken":"...","userId":"...","api":"instagram|facebook"}.
# userId also maps signed Meta webhook callbacks. Facebook mode requires the
# professional IG user id; Instagram mode uses /me.
INSTAGRAM_ACCOUNT_TOKENS_JSON=
META_GRAPH_API_VERSION=v26.0
# Optional legacy single-account fallback, exact-handle gated.
INSTAGRAM_ACCOUNT_HANDLE=
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_MODE=instagram

# Twitch user OAuth uses TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET above.
# Add this production redirect on the Twitch app:
#   https://thecoreboys.com/api/oauth/twitch/callback
# Locally that's often http://localhost:3010/api/oauth/twitch/callback

# Cloudflare R2 media storage (S3-compatible). The SPACES_* names are retained
# for compatibility with the existing upload APIs. Use Standard storage so the
# R2 monthly free allowance applies.
SPACES_REGION=auto
SPACES_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=coreboys-media
SPACES_CDN_ENDPOINT=https://media.thecoreboys.com
# Optional comma-separated additional CDN hosts that the postcard print worker
# may download approved creator-pack assets from. media.thecoreboys.com is
# always allowed; preview URLs never grant print authority on their own.
POSTCARD_PACK_ASSET_HOSTS=

# Resend transactional email — server-only. Verify thecoreboys.com in Resend
# and keep EMAIL_NOTIFICATIONS_ENABLED=false until every required DNS record is
# verified. RESEND_FROM_EMAIL is restricted to the verified .com domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@thecoreboys.com
RESEND_FROM_NAME=The CORE Boys
# Optional; set only to a monitored mailbox.
RESEND_REPLY_TO_EMAIL=
# Explicit production kill switch. Defaults to false when absent.
EMAIL_NOTIFICATIONS_ENABLED=false

# Optional subscription entitlement preview. Leave disabled by default. The
# app accepts this override only in development, on a loopback URL, with a
# loopback DATABASE_URL, no deployment markers, the exact signed-in user id,
# and the acknowledgement below. It never writes a subscription or charges.
SUBSCRIPTION_DEV_OVERRIDE_ENABLED=false
SUBSCRIPTION_DEV_OVERRIDE_ACK=
SUBSCRIPTION_DEV_OVERRIDE_USER_ID=
SUBSCRIPTION_DEV_OVERRIDE_PLAN=free

# Automated fan postcards. Leave every value blank for the local, no-mail
# simulation. Test and live keys must be configured as a complete matching
# set; partial or mixed modes intentionally disable checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate, explicit recurring-membership switch. The same Stripe account may
# be used for postcards, but memberships stay off until both are configured.
# Stripe webhook endpoint: https://YOUR_DOMAIN/api/account/billing/webhook
STRIPE_MEMBERSHIP_ENABLED=false
STRIPE_MEMBERSHIP_WEBHOOK_SECRET=
# Supporter contribution safety rails are $5–$500/month. Admins can raise the
# minimum, lower the maximum, change the $10 checkout default, publish a billing
# notice, and schedule out-of-range subscriptions to end from /admin/billing.
# The admin wind-down action also stores a durable checkout block in Postgres;
# leave Stripe credentials/webhooks configured until every paid term has ended.
LOB_API_KEY=
# Enable only after Lob confirms this account/edition supports send_date.
LOB_SCHEDULED_MAIL_ENABLED=false

# Authorized default return address for test proofs and live mail. A fan may
# instead enter a complete US return address for an individual order.
LOB_RETURN_NAME=
LOB_RETURN_LINE1=
LOB_RETURN_LINE2=
LOB_RETURN_CITY=
LOB_RETURN_STATE=
LOB_RETURN_ZIP=
SOCIAL_NOTIFICATIONS_DELIVERY_ENABLED=false
# Reconciliation persists older catalog entries without notifying users. The
# The three-hour default covers the two-hour Instagram Reels polling window
# plus normal scheduler jitter without alerting on an old historical backfill.
SOCIAL_NOTIFICATION_MAX_AGE_HOURS=3
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@thecoreboys.com
TWITCH_EVENTSUB_SECRET=
# Optional public HTTPS callback origin when it differs from NEXT_PUBLIC_SITE_URL.
# Provider webhooks require HTTPS on port 443; localhost is intentionally rejected.
SOCIAL_WEBHOOK_BASE_URL=
# Optional dedicated provisioner secret. Falls back to METRICS_CRON_SECRET.
SOCIAL_SUBSCRIPTION_CRON_SECRET=
# PubSubHubbub POST signing secret and optional GET challenge token.
YOUTUBE_WEBHOOK_SECRET=
YOUTUBE_WEBHOOK_VERIFY_TOKEN=
# Optional channel-id to CORE owner mapping for secondary YouTube channels.
# Example: {"UC_SECONDARY_ID":"marlon","UC_HOUSE_ID":"core"}
YOUTUBE_WEBHOOK_CHANNEL_OWNERS_JSON=
META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET may be omitted when FACEBOOK_APP_SECRET or
# INSTAGRAM_CLIENT_SECRET is the same app secret used for webhooks.
META_APP_SECRET=

# Production-only private preview gate. Leave both values unset for local
# development. The cookie secret should be a long, randomly generated value.
SITE_ACCESS_CODE=
SITE_ACCESS_COOKIE_SECRET=
