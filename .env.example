# Twitch Helix — used by app/api/twitch/live for live status.
# Create an app at https://dev.twitch.tv/console/apps and use the
# client-credentials grant.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional, used for canonical absolute URLs in OG/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk — only needed if you visit /admin/*. Public site works without
# these. Get keys at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated email allowlist for /admin (checked in app/admin/layout.tsx)
ADMIN_EMAILS=
