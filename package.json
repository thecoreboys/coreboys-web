{
  "name": "coreboys-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-db-firewall.mjs",
    "dev": "next dev --turbopack",
    "predev:https:tiktok": "pnpm run predev && node scripts/check-tiktok-dev-host.mjs",
    "dev:https:tiktok": "next dev --turbopack --experimental-https --hostname 127-0-0-1.sslip.io --port 3003",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "social:check": "node --no-warnings --env-file=.env.local scripts/check-social-connections.mjs",
    "billing:check": "node --no-warnings --env-file=.env.local scripts/check-billing-setup.mjs",
    "social:audit-sources": "node --no-warnings --env-file=.env.local scripts/audit-social-source-registry.mjs",
    "social:cleanup-source-identities": "node --no-warnings --env-file=.env.local scripts/cleanup-social-source-identities.mjs",
    "notifications:bootstrap-vapid": "node scripts/bootstrap-local-vapid.mjs",
    "social:bootstrap-webhook-secrets": "node scripts/bootstrap-local-webhook-secrets.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "upload-media": "node --env-file=.env.local scripts/upload-media-assets.mjs",
    "media-intelligence:sync": "node --env-file=.env.local scripts/run-media-intelligence-sync.mjs",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:apply-web-migrations": "node scripts/apply-web-migrations.mjs",
    "db:apply-media-intelligence": "node scripts/apply-media-intelligence-migrations.mjs",
    "face:purge-retention": "node scripts/run-face-retention.mjs"
  },
  "dependencies": {
