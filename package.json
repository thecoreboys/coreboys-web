    "bad-words": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "exifr": "^7.1.3",
    "framer-motion": "^11.11.0",
    "gsap": "^3.12.5",
    "input-otp": "^1.4.2",
    "jose": "^6.2.3",
    "lenis": "^1.1.13",
