    "react-hotkeys-hook": "^5.3.2",
    "react-stately": "^3.47.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "simple-icons": "^13.14.0",
    "stripe": "^22.2.1",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.6.0",
    "three": "^0.169.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
